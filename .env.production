# devnull production environment configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional fallback provider
ANTHROPIC_API_KEY=

# GitHub token for github_tool
GITHUB_TOKEN=

# API server authentication - set a strong key for production
DEVNULL_API_KEY=devnull-prod-api-key-change-me

# ReAct loop iteration ceiling
MAX_ITERATIONS=25

# PostgreSQL
POSTGRES_USER=devnull
POSTGRES_PASSWORD=devnull_pass
POSTGRES_DB=devnull

# Database URL (auto-configured by docker-compose)
DATABASE_URL=postgresql://devnull:devnull_pass@postgres:5432/devnull

# Admin credentials for the API
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# ACME email for Let's Encrypt (used by Traefik)
ACME_EMAIL=admin@example.com
